# Explicit override for local dev, where the API has no subdomain of its own.
# Point this at wherever your local API actually runs: http://localhost:8080 for the
# Docker-based dev stack (see the backend repo's compose.yaml), or the Kestrel dev port
# below if running the API directly via `dotnet run`.
#
# Leave this UNSET in production (don't set VITE_API_BASE_URL as a build-time variable in
# CI) — client.ts then derives the API origin from the page's own domain at runtime
# (https://api.<hostname>), so the same build works correctly on every domain Caddy serves
# it from, matching Caddyfile's api.<domain> convention. See the backend repo's Caddyfile.
VITE_API_BASE_URL=https://localhost:7112
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
