# API location. The frontend always prepends "api." and reuses the page's protocol, so set
# just the DOMAIN here (see src/api/client.ts):
#   VITE_API_DOMAIN=localhost     -> http://api.localhost
#   VITE_API_DOMAIN=example.com   -> https://api.example.com
# Leave VITE_API_DOMAIN unset to use the current page's hostname automatically.
# VITE_API_BASE_URL is a full-URL override that wins over everything (e.g. http://localhost:8080).
VITE_API_DOMAIN=localhost:8080
